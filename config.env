CONFIG_ENV=config.env
KERNEL_SOURCE=https://github.com/hfjxjdb/LawRun_realme_sdm710
KERNEL_SOURCE_BRANCH=master
KERNEL_CONFIG=RMX1901_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

# 换回自动注入（虽然不支持 KPM，但一定能过）
KSU_VARIANT=resukisu
KSU_REF=

# 基础补丁
ENABLE_PATH_UMOUNT=true
# 全关高级功能，保基础 Root
ENABLE_KPM=false
ENABLE_SUSFS=false
ENABLE_HIDE_STUFF=false
