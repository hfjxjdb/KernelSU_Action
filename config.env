CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/negrroo/LawRun_realme_sdm710
KERNEL_SOURCE_BRANCH=master
KERNEL_CONFIG=RMX1901_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

# 换回原版 KernelSU，并锁死 v0.9.5 老内核版本
KSU_VARIANT=kernelsu
KSU_REF=v0.9.5

# 自动挂钩模式
KSU_HOOK_MODE=auto

# 补全 4.9 内核的 path_umount
ENABLE_PATH_UMOUNT=true

# 关掉所有高级功能，确保基础 root 100% 成功
ENABLE_KPM=false
ENABLE_SUSFS=false
ENABLE_HIDE_STUFF=false