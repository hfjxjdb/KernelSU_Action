CONFIG_ENV=config.env

# 注意：换成你刚刚 Fork 的仓库地址！
KERNEL_SOURCE=https://github.com/hfjxjdb/LawRun_realme_sdm710
KERNEL_SOURCE_BRANCH=master
KERNEL_CONFIG=RMX1901_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

# 核心：设为 none，让 Actions 直接编译我们手动改好的源码，不再去跑自动脚本
KSU_VARIANT=none

ENABLE_PATH_UMOUNT=true

# ⚠️ 建议首次编译先关闭 KPM 和 SUSFS，确保基础 Root 成功！
ENABLE_KPM=false
ENABLE_SUSFS=false
ENABLE_HIDE_STUFF=false
