# ================= 设备基础信息 =================
DEVICE_NAME="oppo_k3"
DEVICE_CODENAME="PCGM00"
ARCH="arm64"

# ================= 内核源码配置 =================
# 使用 OPPO 官方开源内核，兼容性最好
KERNEL_SOURCE="https://github.com/oppo-source/android_kernel_oppo_sdm710"
KERNEL_SOURCE_BRANCH="oppo/sdm710_r_11.0_reno"

# ⚠️ 注意：官方源码没有 sdm710 配置文件，必须用同源的 sdm670
KERNEL_CONFIG="vendor/sdm670-perf_defconfig"
KERNEL_IMAGE_NAME="Image.gz-dtb"

# ================= KernelSU 变体选择 =================
# 核心需求：指定使用 ReSukiSU
KSU_VARIANT="resukisu"
# 如果是 4.9 内核，建议使用 manual 或 syscall 钩子（保持默认即可）
KSU_HOOK_METHOD="manual"

# ================= 编译工具链 =================
CLANG_SOURCE="https://github.com/LineageOS/android_prebuilts_clang_kernel_linux-x86_clang-r416183b.git"
CLANG_BRANCH="lineage-19.1"
GCC_64_SOURCE="https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_aarch64_aarch64-linux-android-4.9.git"
GCC_64_BRANCH="lineage-19.1"
GCC_32_SOURCE="https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9.git"
GCC_32_BRANCH="lineage-19.1"

# ================= 功能开关（首次编译建议全关） =================
# ⚠️ SUSFS 和 KPM 在 4.9 内核上极易导致编译失败或开机死机
# 先保证基础 Root 功能，成功开机后再考虑开启
SUSFS_ENABLE="false"
KPM_ENABLE="false"
KPROBES_ENABLE="false"

# ================= 打包配置 =================
# 使用 AnyKernel3 打包
PACK_METHOD="AnyKernel3"
AK3_SOURCE="https://github.com/osm0sis/AnyKernel3.git"
AK3_BRANCH="master"

# 其他
ENABLE_CCACHE="true"
